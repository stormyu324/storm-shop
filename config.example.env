# Storm 商城配置示例
# 使用方法：把本文件复制一份，命名为 config.env（和 start.sh / start.bat 放在同一个文件夹），
# 去掉需要的行前面的 #，填上自己的值。启动脚本会自动读取。
# config.env 里有密码和密钥，已加入 .gitignore，不会被提交到 GitHub。
# 格式：每行一个 名称=值，值不需要加引号。

# ===== 基本 =====
# 网站端口（默认 8080）
# PORT=8080

# 后台账号密码（上线前一定要改；正式环境模式下密码至少 8 位）
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=换成你的强密码

# 正式环境模式：拒绝默认密码、不写示例数据、开启模板缓存
# SPRING_PROFILES_ACTIVE=prod
# 正式环境的会话 Cookie 只走 HTTPS；临时只能用 HTTP 访问时设为 false（不建议长期这样）
# SESSION_COOKIE_SECURE=true
# 密钥文件目录：每个文件名是变量名、内容是值（如 ADMIN_PASSWORD），可以代替在本文件里写密码
# SECRETS_DIR=/run/secrets/
# 内容安全策略，留空用默认值（只允许本站脚本）；接入第三方脚本时整条覆盖
# SECURITY_CSP=

# 首次启动是否写入示例商品（默认 true）
# DEMO_DATA=true

# 网站对外网址：部署上线后填写，导出平台表格的图片链接、Stripe 付款后跳回本站都要用
# PUBLIC_BASE_URL=https://www.myshop.com

# 美元价格没填时的换算汇率（1 美元 = 多少人民币）
# CNY_PER_USD=7.10

# 线下收款订单超过多少小时未确认收款就自动取消、退回库存（默认 72；0 表示不自动取消）
# OFFLINE_ORDER_CANCEL_HOURS=72

# ===== AI 生成英文资料（Claude）=====
# 在 https://console.anthropic.com 创建 API Key
# ANTHROPIC_API_KEY=sk-ant-...
# 前台 AI 导购：是否开启、每个访客 10 分钟内最多次数、全站每天最多次数
# AI_RECOMMEND=true
# AI_RECOMMEND_PER_CLIENT=10
# AI_RECOMMEND_DAILY_LIMIT=300

# ===== Stripe 在线支付 =====
# 测试时用 sk_test_ 开头的密钥，测试卡号 4242 4242 4242 4242
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CURRENCIES=USD

# ===== 邮件（订单通知、查单和会员登录的验证码）=====
# 用邮件服务商提供的 SMTP 信息；发件人域名需按服务商要求设置 SPF / DKIM
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=shop@example.com
# SPRING_MAIL_PASSWORD=...
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# SHOP_MAIL_FROM=shop@example.com

# ===== 数据库 =====
# 默认使用自带的数据库，数据保存在 data/shop.mv.db，不用设置。
# 换成 MySQL：按 README“换成 MySQL”建好数据库，去掉下面三行的 #，再双击 migrate-to-mysql 搬原来的数据
# DB_URL=jdbc:mysql://localhost:3306/shop
# DB_USERNAME=shop
# DB_PASSWORD=...

# ===== 备份（双击 backup.bat / backup.command）=====
# 备份保存位置，可以设成网盘同步文件夹，例如 D:/OneDrive/商城备份
# BACKUP_DIR=./backups
# 保留最近几份备份，更早的自动删除；0 表示全部保留
# BACKUP_KEEP=30
# 用 MySQL 时，找不到 mysqldump 可以在这里指定完整路径
# MYSQLDUMP=C:/Program Files/MySQL/MySQL Server 8.0/bin/mysqldump.exe

# ===== 企业级集群与扩展配置（日均千单推荐）=====
# 后台超管双因素认证（Base32 密钥，兼容 Google Authenticator；登录时通过 X-Admin-TOTP 传入 6 位码）
# ADMIN_TOTP_SECRET=

# Redis 无状态集群（开启后自动启用 Spring Session、热点读缓存、分布式限流/幂等/防爆破）
# REDIS_ENABLED=true
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# S3 兼容对象存储与 CDN（支持 AWS S3 / Cloudflare R2 / 阿里云 OSS / MinIO）
# STORAGE_TYPE=s3
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=my-shop-bucket
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_BASE_URL=https://cdn.myshop.com

# PayPal Orders v2 在线支付
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_SANDBOX=false
# PAYPAL_CURRENCIES=USD

# 高吞吐发信与数据库连接池调优
# MAIL_CONCURRENCY=4
# DB_POOL_MAX=20
# DB_POOL_MIN=5
