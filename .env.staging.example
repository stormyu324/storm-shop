# 预发布环境配置示例：复制为 .env.staging（已加入 .gitignore），见 docs/staging.md
# 和正式环境放在同一台服务器时，端口、密钥、备份、证书目录都要和正式环境分开

PUBLIC_BASE_URL=https://staging.shop.example.com:8443
HTTP_PORT=8080
HTTPS_PORT=8443
PROMETHEUS_PORT=19090
ALERTMANAGER_PORT=19093
GRAFANA_PORT=13000

SECRETS_PATH=./secrets-staging
BACKUP_PATH=./backups-staging
CERTS_PATH=./deploy/certs-staging

# 压测时所有请求来自同一台机器，调大单 IP 下单上限（正式环境不要设置）
ORDER_PER_IP_LIMIT=1000000

# 支付用测试模式：Stripe 用 sk_test_ 开头的密钥（写在 secrets-staging/STRIPE_SECRET_KEY），PayPal 用沙箱
PAYPAL_SANDBOX=true
